# Copie para ".env" e troque os valores. Use apenas letras e números nas senhas do Mongo
# (elas entram numa URL de conexão).

HTTP_PORT=80

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=troque_esta_senha_root
MONGO_DB=agenda
# Segredo do replica set (6–1024 caracteres base64). Gere com: openssl rand -base64 48
MONGO_KEYFILE=troque_por_um_segredo_base64_longo_gerado_com_openssl
MONGO_APP_USER=agenda_app
MONGO_APP_PASSWORD=troque_esta_senha_app

# Gere com: openssl rand -hex 48
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=15m
# Validade do refresh token (dias). O app renova o acesso sozinho enquanto ele valer.
REFRESH_TOKEN_DAYS=30

# Fuso usado para validar "dia da semana + horário" das disponibilidades
APP_TIMEZONE=America/Sao_Paulo

# Granularidade das reservas (minutos). Início/fim precisam ser múltiplos disso.
# Deve dividir 1440 (5, 10, 15, 30, 60). Também define o tamanho dos "blocos" de trava anti-corrida.
SLOT_MINUTES=15

# Administrador criado automaticamente na primeira inicialização
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=TroqueEstaSenha123

# Flutter Web: origem(ns) permitida(s), separadas por vírgula. Vazio = qualquer origem.
CORS_ORIGIN=
# Em produção, considere "false" para esconder /api/docs
ENABLE_SWAGGER=true

# --- Limites por pessoa (0 = sem limite; administradores são isentos) ---
LIMIT_MAX_MINUTES_PER_DAY=0     # ex.: 240 = máx. 4h de reservas por dia
LIMIT_MAX_ACTIVE_FUTURE=0       # ex.: 20 = máx. 20 reservas futuras ativas
LIMIT_MIN_ADVANCE_MINUTES=0     # ex.: 30 = reservar com 30 min de antecedência
LIMIT_MAX_ADVANCE_DAYS=0        # ex.: 90 = no máximo 90 dias à frente

# --- Endereço público (usado na URL do feed .ics). Ex.: https://agenda.suaescola.com.br ---
PUBLIC_BASE_URL=

# --- Rotinas automáticas (no-show e expiração de pendências). "false" desliga ---
JOBS_ENABLED=true

# --- E-mail (SMTP). Vazio = desligado ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Agenda <agenda@suaescola.com.br>"

# --- Push (Firebase Cloud Messaging). Cole o JSON da conta de serviço em UMA linha. Vazio = desligado ---
FCM_SERVICE_ACCOUNT_JSON=
